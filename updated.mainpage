<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           x:Class="MauiAppYourProject.MainPage"
           FlyoutLayoutBehavior="Split">

    <FlyoutPage.Flyout>
        <ContentPage Title="Navigation Menu" BackgroundColor="#F5F5F5">
            <ScrollView>
                <VerticalStackLayout Padding="15" Spacing="20">

                    <Image Source="menu_icon.png" HorizontalOptions="Start" HeightRequest="24" WidthRequest="24"/>

                    <HorizontalStackLayout Spacing="15" Padding="5">
                        <Image Source="home_icon.png" HeightRequest="24" WidthRequest="24"/>
                        <Label Text="HOME" VerticalOptions="Center" FontAttributes="Bold" FontSize="16"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="15" Padding="5">
                        <Image Source="settings_icon.png" HeightRequest="24" WidthRequest="24"/>
                        <Label Text="SETTINGS" VerticalOptions="Center" FontAttributes="Bold" FontSize="16"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="15" Padding="5">
                        <Image Source="notes_icon.png" HeightRequest="24" WidthRequest="24"/>
                        <Label Text="NOTES" VerticalOptions="Center" FontAttributes="Bold" FontSize="16"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Padding="20,0,0,0" Spacing="10">
                        <Label Text="> view notes" FontSize="14" Color="Gray"/>
                        <Label Text="> new note" FontSize="14" Color="Gray"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </ContentPage>
    </FlyoutPage.Flyout>

    <FlyoutPage.DetailPage>
        <NavigationPage>
            <x:Arguments>
                <ContentPage Title="Main Panel" BackgroundColor="White">
                    <Grid RowDefinitions="Auto, *" Padding="20">

                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Padding="0,0,0,15">
                            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                                <Image Source="profile_icon.png" HeightRequest="30" WidthRequest="30"/>
                                <Label Text="Login / Signup" VerticalOptions="Center" FontSize="16" FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <Button Grid.Column="2"
                                   Text="+"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   BackgroundColor="#512BD4"
                                   HeightRequest="40"
                                   WidthRequest="40"
                                   CornerRadius="20"
                                   Padding="0"
                                   Clicked="OnAddButtonClicked"/>
                        </Grid>

                        <ScrollView Grid.Row="1">
                            <VerticalStackLayout Spacing="15" Padding="0,10,0,0">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="•" FontSize="18" FontAttributes="Bold"/>
                                    <Label Text="Laundry" FontSize="18"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="•" FontSize="18" FontAttributes="Bold"/>
                                    <Label Text="Cooking" FontSize="18"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="•" FontSize="18" FontAttributes="Bold"/>
                                    <Label Text="Cleaning" FontSize="18"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </ScrollView>

                        <Button Grid.Row="1"
                               Text="Q"
                               FontSize="18"
                               TextColor="White"
                               BackgroundColor="#512BD4"
                               HeightRequest="56"
                               WidthRequest="56"
                               CornerRadius="28"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               Margin="0,0,10,10"
                               Clicked="OnSearchFABClicked"/>
                    </Grid>
                </ContentPage>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.DetailPage>

</FlyoutPage>
